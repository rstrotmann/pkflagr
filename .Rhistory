#     "[1-9,]"))
# patterns <- objects$drug
# temp <- data.frame(
#   name = cm$CMDECOD,
#   m = purrr::map(patterns, function(x) {str_detect(cm$CMDECOD, x)})
# )
# objects <- drug_list
temp <- data.frame(
name = cm$CMDECOD,
m = purrr::map(drug_list$DRUG, function(x) {str_detect(cm$CMDECOD, x)})
)
colnames(temp) <- NULL
cm %>%
mutate(object_index = apply(
temp, 1, function(x) {
which(x[-1] == TRUE)}
)) %>%
unnest(object_index) %>%
left_join(drug_list, by = "object_index")
}
